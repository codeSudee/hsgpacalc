---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { useT, getLang } from '../i18n';

interface Props { title?: string; description?: string; path?: string; noindex?: boolean; type?: 'app' | 'page' | 'article'; enOnly?: boolean; alternates?: { hreflang: string; href: string }[]; heading?: string; published?: string; modified?: string; }
const { title, description, path, noindex, type, enOnly, alternates, heading, published, modified } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} path={path} noindex={noindex} type={type} enOnly={enOnly} alternates={alternates} heading={heading} published={published} modified={modified} />
    <slot name="head" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778789012514648" crossorigin="anonymous"></script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8DKW0JRVPP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8DKW0JRVPP');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hsgpa-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
          document.querySelectorAll('meta[name=theme-color]').forEach(function (m) { m.setAttribute('content', t === 'dark' ? '#0a0a0a' : '#fafafa'); });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#calculator">{t.skip}</a>
    <slot />
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);
      const lenis = new Lenis({ respectReducedMotion: true, anchors: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      // Subtle fade-up as major sections scroll into view (never the calculator itself).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.utils.toArray<HTMLElement>('[data-scroll-reveal]').forEach((el) => {
          gsap.from(el, {
            opacity: 0, y: 24, duration: 0.55, ease: 'power2.out', clearProps: 'all',
            scrollTrigger: { trigger: el, start: 'top 90%', once: true },
          });
        });
      }
    </script>
  </body>
</html>
