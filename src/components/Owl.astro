---
// Decorative study-buddy owl. Pose is switched by calculator.ts via data-pose (neutral | great | keep).
---
<svg viewBox="0 0 96 96" class="owl" data-owl data-pose="neutral" aria-hidden="true" focusable="false" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <!-- feet -->
  <path d="M38 88v4M44 88v4M52 88v4M58 88v4" stroke="var(--mute)" />
  <!-- ear tufts + body -->
  <path d="M24 36 22 16 40 28Z M72 36 74 16 56 28Z" fill="var(--soft)" />
  <ellipse cx="48" cy="56" rx="28" ry="31" fill="var(--soft)" />
  <path d="M38 74q10 6 20 0M40 80q8 4 16 0" stroke="var(--mute)" />
  <!-- eyes -->
  <g data-p="neutral keep">
    <circle cx="36" cy="48" r="10" fill="var(--elevated)" /><circle cx="60" cy="48" r="10" fill="var(--elevated)" />
    <circle cx="36" cy="49" r="4" fill="var(--ink)" /><circle cx="60" cy="49" r="4" fill="var(--ink)" />
  </g>
  <g data-p="great"><path d="M27 51q9-11 18 0M51 51q9-11 18 0" stroke-width="3" /></g>
  <g data-p="keep"><path d="M25 36l19 5M71 36l-19 5" stroke-width="3" /></g>
  <!-- beak -->
  <path d="M44 57l4 8 4-8Z" fill="var(--ring-weighted)" stroke="var(--ring-weighted)" />
  <!-- wings -->
  <g data-p="neutral keep"><path d="M21 56q-8 14 5 26M75 56q8 14-5 26" fill="var(--elevated)" /></g>
  <g data-p="great"><path d="M22 58 8 42q-2 14 8 28M74 58 88 42q2 14-8 28" fill="var(--elevated)" /></g>
  <!-- grad cap + sparkles for the great pose -->
  <g data-p="great">
    <path d="M28 20 48 11l20 9-20 9Z" fill="var(--ink)" /><path d="M68 20v10" stroke="var(--ring-weighted)" />
    <path d="M10 22v8M6 26h8M86 14v6M83 17h6" stroke="var(--ring-weighted)" />
  </g>
</svg>
