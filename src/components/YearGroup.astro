---
// Template for one year group (cloned by the calculator script).
import { useT } from '../i18n';
const t = useT(Astro.currentLocale).calc;
---
<template id="tpl-year">
  <section class="py-5 first:pt-0" data-year aria-label={t.year}>
    <div class="mb-1 flex items-end gap-2 sm:gap-3">
      <label class="min-w-0 flex-1"><span class="lbl">{t.yearName}</span><input class="field font-medium" data-f="yname" name="year-name" autocomplete="off" type="text" maxlength="30" /></label>
      <div class="shrink-0 text-right">
        <span class="eyebrow block text-[10px] sm:text-[12px]">{t.yearGpa}</span>
        <span class="num text-xs sm:text-sm text-[var(--ink)]" data-year-gpa>–</span>
      </div>
      <button type="button" class="btn btn-icon btn-danger no-print shrink-0" data-action="remove-year" aria-label={t.removeYear}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
      </button>
    </div>
    <div data-classes></div>
    <button type="button" class="btn no-print mt-2" data-action="add-class">{t.addClass}</button>
  </section>
</template>
