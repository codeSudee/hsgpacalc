---
import { faqs, faqSchema } from '../data/faqs';
const schema = faqSchema(faqs);
---

<section id="faq" aria-labelledby="faq-heading" class="mx-auto w-full max-w-3xl px-6 py-20">
  <h2 id="faq-heading" class="text-3xl font-semibold tracking-tight text-[var(--ink)] md:text-4xl">
    Frequently Asked Questions
  </h2>
  <p class="mt-3 text-base text-[var(--body)]">
    Quick answers about weighted and unweighted GPA, AP and Honors points, and how colleges read your grades.
  </p>

  <div class="mt-10 divide-y divide-[var(--hairline)] overflow-hidden rounded-xl border border-[var(--hairline)] bg-[var(--elevated)]">
    {
      faqs.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-medium text-[var(--ink)] transition-colors hover:bg-[var(--soft)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--link)] [&::-webkit-details-marker]:hidden">
            <span class="text-base font-medium text-[var(--ink)]">{f.question}</span>
            <svg
              class="size-4 shrink-0 text-[var(--mute)] transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m4 6 4 4 4-4" />
            </svg>
          </summary>
          <div class="px-5 pb-5 text-[15px] leading-relaxed text-[var(--body)]">
            <p>{f.answer}</p>
          </div>
        </details>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
