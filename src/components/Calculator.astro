---
import ClassRow from './ClassRow.astro';
import YearGroup from './YearGroup.astro';
import GpaGauge from './GpaGauge.astro';
import { useT } from '../i18n';
const T = useT(Astro.currentLocale);
const t = T.calc;
---
<ClassRow />
<YearGroup />
<div id="calculator" class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_380px]" data-calc>
  <div class="card p-4 md:p-6" data-reveal>
    <div class="no-print mb-5 flex flex-wrap items-center gap-3">
      <div class="seg" role="group" aria-label={t.scaleGroup}>
        <button type="button" data-scale="plus" aria-pressed="true">{t.scalePlus}</button>
        <button type="button" data-scale="plain" aria-pressed="false">{t.scalePlain}</button>
        <button type="button" data-scale="p433" aria-pressed="false">{t.scale433}</button>
      </div>
      <button type="button" class="btn" data-action="sample">{t.sample}</button>
      <button type="button" class="btn btn-danger ml-auto" data-action="reset">{t.reset}</button>
    </div>
    <p class="no-print mt-0 mb-3 text-[13px] text-[var(--mute)]" id="scale-note"></p>
    <details class="no-print mb-4 rounded-md border border-[var(--hairline)] p-3" id="settings">
      <summary class="cursor-pointer text-[13px] font-medium text-[var(--ink)]">{t.settings}</summary>
      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <label><span class="lbl">{t.honorsBonus}</span><input class="field num" id="s-honors" name="honors-bonus" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="2" step="0.05" /></label>
        <label><span class="lbl">{t.apBonus}</span><input class="field num" id="s-ap" name="ap-bonus" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="2" step="0.05" /></label>
        <div class="col-span-2 flex items-end sm:col-span-1"><button type="button" class="btn w-full" data-action="reset-bonus">{t.defaultBonuses}</button></div>
      </div>
      <p class="mt-1 mb-0 text-xs text-[var(--mute)]">{t.bonusNote}</p>
      <p class="eyebrow m-0 mt-4 mb-2">{t.priorHeading}</p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <label><span class="lbl">{t.unweighted}</span><input class="field num" id="p-u" name="prior-unweighted-gpa" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="4.33" step="0.01" /></label>
        <label><span class="lbl">{t.weightedBlank}</span><input class="field num" id="p-w" name="prior-weighted-gpa" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="7" step="0.01" /></label>
        <label class="col-span-2 sm:col-span-1"><span class="lbl">{t.creditsEarned}</span><input class="field num" id="p-cr" name="prior-credits" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="400" step="0.5" /></label>
      </div>
      <p class="mt-1 mb-0 text-xs text-[var(--mute)]">{t.priorNote}</p>
    </details>
    <div id="years" class="divide-y divide-[var(--hairline)]"></div>
    <button type="button" class="btn btn-primary no-print mt-4" data-action="add-year">{t.addYear}</button>
  </div>

  <aside class="flex flex-col gap-6 lg:sticky lg:top-6" aria-label={t.results} data-reveal>
    <div class="card p-5">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-xl leading-7" style="letter-spacing:-0.02em">{t.yourGpa}</h2>
        <div class="seg no-print" role="group" aria-label={t.viewGroup}>
          <button type="button" data-view="us" aria-pressed="true">{t.viewUs}</button>
          <button type="button" data-view="de" aria-pressed="false" lang="de">{t.viewDe}</button>
        </div>
      </div>
      <GpaGauge />
      <div class="mt-5 border-t border-[var(--hairline)] pt-4">
        <p class="eyebrow m-0 mb-2">{t.byYear}</p>
        <ul class="m-0 list-none space-y-1 p-0" id="year-summary"></ul>
      </div>
      <div class="mt-5 border-t border-[var(--hairline)] pt-4" id="trend-wrap" hidden>
        <p class="eyebrow m-0 mb-2">{t.trend}</p>
        <div class="mb-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[var(--body)]" aria-hidden="true">
          <span class="inline-flex items-center gap-2"><svg width="22" height="8" aria-hidden="true"><line x1="1" y1="4" x2="21" y2="4" stroke="var(--ring-unweighted)" stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round"/></svg>{t.unweighted}</span>
          <span class="inline-flex items-center gap-2"><svg width="22" height="8" aria-hidden="true"><line x1="1" y1="4" x2="21" y2="4" stroke="var(--ring-weighted)" stroke-width="2" stroke-linecap="round"/></svg>{t.weighted}</span>
        </div>
        <div id="trend"></div>
      </div>
      <div class="no-print mt-5 flex flex-wrap gap-2">
        <button type="button" class="btn" data-action="copy">{t.copyResults}</button>
        <button type="button" class="btn" data-action="copy-link">{t.copyLink}</button>
        <button type="button" class="btn" data-action="csv">{t.csv}</button>
        <button type="button" class="btn" data-action="share" hidden>{t.share}</button>
        <button type="button" class="btn" data-action="print">{t.print}</button>
      </div>
    </div>

    <div class="card no-print p-5">
      <h2 class="text-xl leading-7" style="letter-spacing:-0.02em">{t.plannerTitle}</h2>
      <p class="mt-1 mb-4 text-[13px] text-[var(--mute)]">{t.plannerIntro}</p>
      <div class="grid grid-cols-2 gap-3">
        <label><span class="lbl">{t.targetGpa}</span><input class="field num" id="t-target" name="target-gpa" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="5" step="0.01" /></label>
        <label><span class="lbl">{t.upcomingCredits}</span><input class="field num" id="t-credits" name="upcoming-credits" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0.5" max="40" step="0.5" /></label>
        <label class="col-span-2"><span class="lbl">{t.goalApplies}</span>
          <select class="select" id="t-type" name="goal-type" autocomplete="off"><option value="u">{t.goalU}</option><option value="w">{t.goalW}</option></select>
        </label>
      </div>
      <p class="mt-4 mb-0 rounded-md bg-[var(--soft)] p-3 text-[13px] leading-5 text-[var(--ink)]" id="t-result" aria-live="polite">{T.js.plannerEmpty}</p>
    </div>
  </aside>
  <div id="toast" class="toast no-print" role="status" aria-live="polite" aria-atomic="true" hidden>
    <span data-toast-msg></span>
    <button type="button" class="toast-btn" data-toast-undo>{t.undo}</button>
  </div>
  <p class="sr-only" role="status" aria-live="polite" id="live"></p>
  <p class="print-only" id="print-note"></p>
</div>
<script type="application/json" id="i18n-data" set:html={JSON.stringify(T.js)} />
<script>
  import '../scripts/calculator';
</script>
