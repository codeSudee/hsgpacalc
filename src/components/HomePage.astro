---
import Layout from '../layouts/Layout.astro';
import Calculator from './Calculator.astro';
import GoodGpaTable from './GoodGpaTable.astro';
import SeoContent from './SeoContent.astro';
import SeoContentEs from './SeoContent.es.astro';
import Faq from './Faq.astro';
import GuideLinks from './GuideLinks.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { useT, getLang, localePath } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const nav = [
  { path: '/about/', label: t.footer.about },
  { path: '/contact/', label: t.footer.contact },
  { path: '/privacy-policy/', label: t.footer.privacy },
  { path: '/terms-and-conditions/', label: t.footer.terms },
];
---
<Layout path="/">
  <SiteHeader />

  <main id="main">
    <section class="relative isolate overflow-hidden">
      <div class="mesh" aria-hidden="true"></div>
      <div aria-hidden="true">
        <svg class="float-icon left-[5%] top-[14%] hidden size-14 sm:block" style="animation-duration:12s" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 40 2-9L33 8l7 7-23 23-9 2ZM28 13l7 7M10 31l7 7"/></svg>
        <svg class="float-icon right-[6%] top-[18%] size-14" style="animation-duration:14s;animation-delay:-4s" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m24 9 21 10-21 10L3 19 24 9ZM12 25v10c4 4 20 4 24 0V25M45 19v12"/></svg>
        <svg class="float-icon bottom-[10%] left-[12%] hidden size-14 md:block" style="animation-duration:10s;animation-delay:-7s" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 14c-5-4-12-5-19-4v27c7-1 14 0 19 4 5-4 12-5 19-4V10c-7-1-14 0-19 4ZM24 14v27"/></svg>
      </div>
      <div class="wrap py-12 text-center md:py-20">
        <p class="eyebrow m-0" data-hero>{t.home.eyebrow}</p>
        <h1 class="mx-auto mt-4 max-w-[16ch]" data-hero>{t.home.h1}</h1>
        <p class="mx-auto mt-4 mb-0 max-w-[58ch] text-base leading-6" data-hero>{t.home.lead}</p>
        <nav aria-label={t.home.pagesNav} class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm" data-hero>
          {nav.map((l) => <a href={localePath(lang, l.path)}>{l.label}</a>)}
        </nav>
      </div>
    </section>

    <div class="wrap pb-16 md:pb-24">
      <Calculator />
      <div class="mt-16 md:mt-24"><GoodGpaTable /></div>
      {lang === 'es' ? <SeoContentEs /> : <SeoContent />}
      {lang === 'en' && <GuideLinks />}
      <Faq />
    </div>
  </main>

  <SiteFooter />

  <script>
    import { gsap } from 'gsap';
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.from('[data-hero]', { opacity: 0, y: 14, duration: 0.6, stagger: 0.1, ease: 'power3.out', clearProps: 'all' });
    }
  </script>
</Layout>
