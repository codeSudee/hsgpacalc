---
import { guides } from '../data/guides';
const { current } = Astro.props;
const others = guides.filter((g) => g.path !== current);
---
<aside class="card mt-10 p-5" aria-labelledby="cta-h">
  <h2 id="cta-h" class="m-0 !mt-0">Try the calculator</h2>
  <p>Enter your classes and see your weighted and unweighted GPA instantly. Free, private, no sign-up.</p>
  <p><a href="/#calculator"><strong>Open the High School GPA Calculator</strong></a></p>
</aside>
<nav aria-label="More guides" class="mt-8">
  <h2>More GPA guides</h2>
  <ul>{others.map((g) => <li><a href={g.path}>{g.title}</a></li>)}</ul>
</nav>
