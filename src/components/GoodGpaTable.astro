---
import { useT } from '../i18n';
const t = useT(Astro.currentLocale).good;
const rows = t.rows;
---
<section aria-labelledby="good-gpa-h" class="card overflow-hidden">
  <div class="p-5 md:p-6">
    <p class="eyebrow m-0">{t.eyebrow}</p>
    <h2 id="good-gpa-h" class="mt-2">{t.heading}</h2>
    <p class="mt-2 mb-0 max-w-[60ch]">{t.intro}</p>
  </div>
  <div class="overflow-x-auto">
    <table class="tbl">
      <caption class="sr-only">{t.caption}</caption>
      <thead><tr><th scope="col">{t.thGpa}</th><th scope="col">{t.thRating}</th><th scope="col">{t.thMeaning}</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr data-good-row data-min={r.min} data-max={r.max}>
            <td class="num">{r.range}</td>
            <td>{r.label}</td>
            <td class="min-w-[220px]">{r.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<style>
  :global([data-good-row][aria-current="true"] td) { background: var(--soft); }
  :global([data-good-row][aria-current="true"] td:first-child) { box-shadow: inset 3px 0 0 var(--link); }
</style>
