---
// Template for one class row (cloned by the calculator script).
import { useT } from '../i18n';
const t = useT(Astro.currentLocale).calc;
const grades = ['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F'];
---
<template id="tpl-class">
  <div class="class-row" data-class-row>
    <label class="c-name"><span class="lbl">{t.className}</span><input class="field" data-f="name" name="class-name" type="text" placeholder={t.classPlaceholder} autocomplete="off" maxlength="60" /></label>
    <label><span class="lbl">{t.level}</span>
      <select class="select" data-f="level" name="class-level" autocomplete="off">
        <option value="reg">{t.regular}</option>
        <option value="hon" data-lv="hon">{useT(Astro.currentLocale).js.levelHon.replace('{b}', '+0.5')}</option>
        <option value="ap" data-lv="ap">{useT(Astro.currentLocale).js.levelAp.replace('{b}', '+1')}</option>
      </select>
    </label>
    <label><span class="lbl">{t.grade}</span>
      <select class="select" data-f="grade" name="class-grade" autocomplete="off">
        <option value="">{t.select}</option>
        {grades.map((g) => <option value={g}>{g}</option>)}
      </select>
    </label>
    <label><span class="lbl">{t.credits}</span><input class="field num" data-f="credits" name="class-credits" autocomplete="off" spellcheck="false" type="number" inputmode="decimal" min="0" max="10" step="0.25" /></label>
    <div class="flex items-center justify-between gap-2 col-span-full min-[900px]:col-span-1 min-[900px]:justify-end">
      <label class="chk" title={t.excludeTitle}><input type="checkbox" data-f="exclude" name="class-exclude" /> {t.exclude}</label>
      <button type="button" class="btn btn-icon btn-danger" data-action="remove-class" aria-label={t.removeClass}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M5 4.5l.5 8h5l.5-8"/></svg>
      </button>
    </div>
  </div>
</template>
